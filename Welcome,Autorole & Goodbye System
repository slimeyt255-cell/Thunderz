$onJoined[$getServerVar[welcome_channel;$guildID]]

$nomention
$c[Code made by Thunderz]
$if[$isBot[$authorID]==true]
  $if[$getServerVar[welcome_bot_role]!=none]
    $if[$getServerVar[welcome_bot_role]!=]
      $giveRole[$authorID;$getServerVar[welcome_bot_role]]
    $endif
  $endif
$else
  $if[$getServerVar[welcome_role]!=none]
    $if[$getServerVar[welcome_role]!=]
      $giveRole[$authorID;$getServerVar[welcome_role]]
    $endif
  $endif
$endif

$if[$getServerVar[welcome_status]==ON]
  $useChannel[$getServerVar[welcome_channel]]
  $title[$getServerVar[welcome_title]]
  $description[$replaceText[$replaceText[$replaceText[$getServerVar[welcome_message];{user};<@$authorID>];{count};$membersCount];{server};$serverName[$guildID]]]
  $footer[$getServerVar[welcome_footer]]
  $color[#$getServerVar[welcome_color]]
  
  $if[$getServerVar[welcome_thumb_status]==ON]
    $if[$getServerVar[welcome_thumbnail]==none]
      $thumbnail[$authorAvatar]
    $elseif[$getServerVar[welcome_thumbnail]==]
      $thumbnail[$authorAvatar]
    $else
      $thumbnail[$getServerVar[welcome_thumbnail]]
    $endif
  $endif
$endif

